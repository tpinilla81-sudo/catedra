# Entorno local — ECOSYSTEM MÉTODO
# Copia este archivo a .env y ajusta si hace falta:  cp .env.example .env

# Base de datos. En local NO hace falta tocarla: si no apunta a postgres,
# src/lib/env-guard.ts la fuerza automáticamente al PG embebido
# (postgresql://postgres:postgres@localhost:5432/metodo).
# Para producción (Neon/Vercel) pon aquí tu cadena postgres real.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metodo"

# Conexión directa (sin pooler) para migraciones. En local, la misma URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/metodo"

# Secreto de firma de sesiones NextAuth (genera uno: openssl rand -hex 24)
NEXTAUTH_SECRET="cambia-esto-en-produccion"
